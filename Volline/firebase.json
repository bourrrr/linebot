{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "region": "asia-east1",
    "secrets": [
      "VOLLINE_LINE_CHANNEL_SECRET",
      "VOLLINE_LINE_CHANNEL_ACCESS_TOKEN",
      "MAIN_LINE_CHANNEL_SECRET",
      "MAIN_LINE_CHANNEL_ACCESS_TOKEN",
      "MAIN_LINE_LOGIN_CHANNEL_ID"
    ],
    "endpoints": {
      "lineWebhookMain": {
        "rawBody": true
      },
      "lineWebhookVol": {
        "rawBody": true
      },
      "authApi": {
        "rawBody": false
      }
    },
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
